<Window xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  
        x:Class="PL.Volunteer.CallTreatmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Icon="pack://application:,,,/sticker.ico"
        Title="CallTreatmentWindow" Height="550" Width="1200"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Closed="Window_Closed" Loaded="Window_Loaded" >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- חצי שמאלי: תיאור קריאה ורשימה -->
            <ColumnDefinition Width="30*"/>
            <!-- חצי ימני: המפה -->
        </Grid.ColumnDefinitions>

        <!-- צד שמאל: רשימת הקריאות ותיאור הקריאה -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- תפריט עליון -->
            <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Filter by call type" HorizontalAlignment="Left" Margin="64,10,0,0" VerticalAlignment="Stretch" FontStyle="Italic" FontWeight="Medium"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ItemsSource="{Binding Source={StaticResource CallTypeCollectionKey}}" 
                      SelectedValue="{Binding Path=typeOfCall, Mode=TwoWay}" 
                      SelectionChanged="ComboBox_SelectionChanged" />
            </Grid>

            <!-- רשימת הקריאות -->
            <ListView Grid.Row="1" ItemsSource="{Binding Path=OpenCallsList}" SelectedItem="{Binding SelectedCall, Mode=TwoWay}"  
              SelectionChanged="ListView_SelectionChanged" Height="531" VerticalAlignment="Top" Background="#803A5F5F" BorderBrush="DarkSlateGray" BorderThickness="15" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="30" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="DarkSlateGray"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontStyle" Value="Italic"/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="CallID" DisplayMemberBinding="{Binding Id}" Width="Auto" />
                        <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="Auto"/>
                        <GridViewColumn Header="Opening Time" DisplayMemberBinding="{Binding OpeningTime}" Width="Auto"/>
                        <GridViewColumn Header="Max Time" DisplayMemberBinding="{Binding MaxTime}" Width="Auto"/>
                        <GridViewColumn Header="Distance From Volunteer" DisplayMemberBinding="{Binding DistanceFromVolunteer}" Width="Auto"/>
                        <GridViewColumn Header="Call Type" DisplayMemberBinding="{Binding CallType}" Width="Auto" />
                        <GridViewColumn Header="Handle" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Handle" 
                                          Click="BtCooseCall_Click" 
                                          Tag="{Binding}" 
                                          Background="Blue" 
                                          BorderThickness="1" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- תיאור הקריאה -->
            <Border Grid.Row="2" CornerRadius="20" Background="#803A5F5F" Padding="50" BorderBrush="LightBlue" BorderThickness="10">
                <TextBlock Text="{Binding SelectedCall.Description}" 
                   FontSize="20" 
                   FontWeight="Light" 
                   FontStyle="Oblique" 
                   TextAlignment="Center" 
                   Foreground="Brown" 
                   Background="Transparent" 
                   TextWrapping="Wrap" 
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
            </Border>
        </Grid>

        <!-- צד ימין: מפה -->
        <Border Grid.Column="1" CornerRadius="20" Background="#803A5F5F" Padding="10" BorderBrush="LightBlue" BorderThickness="10">
            <Wpf:WebView2 x:Name="MapBrowser" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</Window>
