<Window x:Class="PL.Volunteer.CallTreatmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Volunteer"
        mc:Ignorable="d"
        Title="CallTreatmentWindow" Height="550" Width="850"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Closed="Window_Closed" Loaded="Window_Loaded" >
    <Window.Resources>
        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#FF6C757D" />
            <Setter Property="Background" Value="#FF343A40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                     Name="PART_Border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- טריגר לעכבר נכנס -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#FF495057"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!--External Grid-->
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Internal, Upper Grid-->
        <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Filter by call type" HorizontalAlignment="Left" Margin="64,10,0,0"   VerticalAlignment="Stretch" FontStyle="Italic" FontWeight="Medium"/>
            <ComboBox Grid.Column="1"  HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" 
                  ItemsSource="{Binding Source={StaticResource CallTypeCollectionKey}}" SelectedValue="{Binding Path=typeOfCall, Mode=TwoWay}" SelectionChanged="ComboBox_SelectionChanged"  />
        </Grid>

        <Border Grid.Row="2" CornerRadius="30" Background="#803A5F5F" Padding="50" Margin="5,8,5,5" BorderBrush="SeaGreen" BorderThickness="15">
            <TextBlock Text="{Binding SelectedCall.Description}" 
               FontSize="20" 
               FontWeight="Light" 
               FontStyle="Oblique" 
               TextAlignment="Center" 
               Foreground="black" 
               Background="Transparent" 
               TextWrapping="Wrap" 
               VerticalAlignment="Center"
               HorizontalAlignment="Center" />
           </Border>

        <ListView Grid.Row="1" ItemsSource="{Binding Path=OpenCallsList}" SelectedItem="{Binding SelectedCall, Mode=TwoWay}"  Height="531" VerticalAlignment="Top" Background="#803A5F5F" BorderBrush="DarkSlateGray" BorderThickness="15" >
            <ListView.ItemContainerStyle>
                <!-- Height of each line -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="30" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>


                    <GridViewColumn Header="CallID" DisplayMemberBinding="{Binding Id}"  Width="Auto"  />
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="Auto"/>
                    <GridViewColumn Header="Opening Time" DisplayMemberBinding="{Binding OpeningTime}" Width="Auto"/>
                    <GridViewColumn Header="Max Time" DisplayMemberBinding="{Binding MaxTime}" Width="Auto"/>
                    <GridViewColumn Header="Distance From volanteer" DisplayMemberBinding="{Binding DistanceFromvolanteer}" Width="Auto"/>
                    <GridViewColumn Header="Call Type" DisplayMemberBinding="{Binding CallType}" Width="Auto"  />

                    <GridViewColumn Header="Hendel" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Hendel" 
                                      Click="BtCooseCall_Click" 
                                      Tag="{Binding}" 
                                      Background="Blue" 
                                      BorderThickness="1" 
                                      />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>

            </ListView.View>
        </ListView>



    </Grid>
</Window>
