<Window x:Class="PL.Volunteer.MainVolunteerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Volunteer"
        mc:Ignorable="d"
        Background="Gainsboro"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Closed="Window_Closed" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen"
        Title="MainVolunteerWindow" Height="670" Width="800">

    <Window.Resources>
        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Gainsboro"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style for ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style for CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="LightBlue"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Volunteer Section -->
        <GroupBox Header="Volunteer Details" Grid.Row="0" Grid.Column="0" Margin="10" Background="WhiteSmoke">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="ID:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVolunteer.Id, Mode=TwoWay}" IsEnabled="False"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Full Name:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVolunteer.Name, Mode=TwoWay}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Phone:"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentVolunteer.PhoneNumber, Mode=TwoWay}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Email:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentVolunteer.Email, Mode=TwoWay}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Password:"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentVolunteer.Password, Mode=TwoWay}"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Address:"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentVolunteer.Address, Mode=TwoWay}"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Maximum Distance:"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentVolunteer.MaximumDistance, Mode=TwoWay}"/>

                <Label Grid.Row="7" Grid.Column="0" Content="Handled Calls:"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrentVolunteer.HandeledCalls, Mode=TwoWay}"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Canceled Calls:"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding CurrentVolunteer.CanceledCalls, Mode=TwoWay}"/>

                <Label Grid.Row="9" Grid.Column="0" Content="Expired Calls:"/>
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding CurrentVolunteer.ExpiredCalls, Mode=TwoWay}"/>

                <Label Grid.Row="10" Grid.Column="0" Content="Distance Type:"/>
                <ComboBox Grid.Row="10" Grid.Column="1" SelectedValue="{Binding CurrentVolunteer.Distance, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource DistanceTypeCollectionKey}}"/>

                <Label Grid.Row="11" Grid.Column="0" Content="Is Active:"/>
                <CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding CurrentVolunteer.IsActive, Mode=TwoWay}"/>
            </Grid>
        </GroupBox>

        <!-- Call Section -->
        <GroupBox Header="Call Details" Grid.Row="0" Grid.Column="1" Margin="10" Background="WhiteSmoke">
            <StackPanel>
                <Label Content="Current Call Details:"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Call ID:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCall.Id}" IsReadOnly="True"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Call Type:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCall.CallType}" IsReadOnly="True"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Description:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCall.Description}" IsReadOnly="True"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Address:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCall.Address}" IsReadOnly="True"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Opening Time:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCall.OpeningTime}" IsReadOnly="True"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Max Time to Finish:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCall.MaxTime}" IsReadOnly="True"/>
                </Grid>

                <ListView ItemsSource="{Binding CurrentCall.CallAssignsList}" Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Volunteer Id" DisplayMemberBinding="{Binding VolunteerId}"/>
                            <GridViewColumn Header="Volunteer Name" DisplayMemberBinding="{Binding VolunteerName}"/>
                            <GridViewColumn Header="Handle Start Time" DisplayMemberBinding="{Binding HndalStartTime}"/>
                            <GridViewColumn Header="Handle End Time" DisplayMemberBinding="{Binding HndalEndTime}"/>
                            <GridViewColumn Header="Closure Type" DisplayMemberBinding="{Binding ClosureType}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Button Content="Cancel Handling" Click="CallCancel_Click" Margin="5"/>
                <Button Content="End Handling" Click="btnEndCall_Click" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Update" Click="BtnUpdate_Click" Width="100" Height="40" Margin="5"/>
            <Button Content="Call History" Click="BtnHistoryWindows_Click" Width="100" Height="40" Margin="5"/>
            <Button Content="Choosing Call" Click="BtnTreatmentWindow_Click" Width="100" Height="40" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
