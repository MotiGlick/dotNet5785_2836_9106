<Window x:Class="PL.Volunteer.VolunteerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Volunteer"
         xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Background="Gainsboro"
         DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Closed="Window_Closed" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen"
        Title="VolunteerWindow" Icon="pack://application:,,,/sticker.ico"
        Height="670"   Width="{Binding CurrentVolunteer.CallInProgress, Converter={StaticResource BooleanToWidthConverterKey}}">


    <Window.Resources>
        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/> 
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Gainsboro"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style for TextBox -->
        <Style TargetType="xctk:WatermarkTextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style for ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style for CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="LightBlue"/>
        </Style>
    </Window.Resources>

  
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid ShowGridLines="FALSE">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Right Grid (Volunteer Fields) -->
                <Grid Grid.Row="1" Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Volunteer Fields -->

                    <Label Grid.Row="0" Grid.Column="0" Content="Volunteer details:" />

                    <Label Grid.Row="1" Grid.Column="0" Content="ID:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVolunteer.Id, Mode=TwoWay}" />

                    <Label Grid.Row="2" Grid.Column="0" Content="Full Name:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentVolunteer.Name, Mode=TwoWay}" />

                    <Label Grid.Row="3" Grid.Column="0" Content="Phone:" />
                <xctk:WatermarkTextBox Grid.Row="3" Grid.Column="1" 
              Text="{Binding CurrentVolunteer.PhoneNumber, Mode=TwoWay}" 
               MaxLength="10" Watermark="10 numbers starting whit 0"
               ToolTip="Enter a phone number in the format 0xxxxxxxxx" />

                <Label Grid.Row="4" Grid.Column="0" Content="Email:" />
                <xctk:WatermarkTextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentVolunteer.Email, Mode=TwoWay}" Watermark="For exemple: user@gmail.com" />

                    <Label Grid.Row="5" Grid.Column="0" Content="Password:" />
                <xctk:WatermarkTextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentVolunteer.Password, Mode=TwoWay}" Watermark="6 numbers, a capital letter and a small letter"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Address:" />
                <xctk:WatermarkTextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentVolunteer.Address, Mode=TwoWay}" />

                    <Label Grid.Row="7" Grid.Column="0" Content="Maximum Distance:" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrentVolunteer.MaximumDistance, Mode=TwoWay}" />

                    <Label Grid.Row="8" Grid.Column="0" Content="Handled Calls:" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding CurrentVolunteer.HandeledCalls, Mode=TwoWay}" />

                    <Label Grid.Row="9" Grid.Column="0" Content="Canceled Calls:" />
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding CurrentVolunteer.CanceledCalls, Mode=TwoWay}" />

                    <Label Grid.Row="10" Grid.Column="0" Content="Expired Calls:" />
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding CurrentVolunteer.ExpiredCalls, Mode=TwoWay}" />

                    <Label Grid.Row="11" Grid.Column="0" Content="Duty:" />
                    <ComboBox Grid.Row="11" Grid.Column="1" SelectedValue="{Binding CurrentVolunteer.Duty, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource JubCollectionKey}}" />

                    <Label Grid.Row="12" Grid.Column="0" Content="Distance Type:" />
                    <ComboBox Grid.Row="12" Grid.Column="1" SelectedValue="{Binding CurrentVolunteer.Distance, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource DistanceTypeCollectionKey}}" />

                    <Label Grid.Row="13" Grid.Column="0" Content="Is Active:" />
                    <CheckBox Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding CurrentVolunteer.IsActive, Mode=TwoWay}" />
                </Grid>

                <!-- Left Grid (CallInProgress Fields) -->
                <Grid Grid.Row="1" Grid.Column="2" Visibility="{Binding CurrentVolunteer.CallInProgress, Converter={StaticResource BoolToVisibilityConverterKey}}">
                    <StackPanel Visibility="{Binding CurrentVolunteer.CallInProgress, Converter={StaticResource BoolToVisibilityConverterKey}}">
                        <Label Content="Current Call details:" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Assignment ID:" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.Id}" IsEnabled="False" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Call ID:" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.CallId}" IsEnabled="False" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Call Type:" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.CallType}" IsEnabled="False" />

                            <Label Grid.Row="3" Grid.Column="0" Content="Description:" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.Description}" IsEnabled="False" />

                            <Label Grid.Row="4" Grid.Column="0" Content="Address:" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.Address}"  IsEnabled="False"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="Opening Time:" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.OpeningTime}" IsEnabled="False"/>

                            <Label Grid.Row="6" Grid.Column="0" Content="Max Time to Finish:" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.MaxTime}" IsEnabled="False"/>

                            <Label Grid.Row="7" Grid.Column="0" Content="Handle Start Time:" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrentVolunteer.CallInProgress.HndalStartTime}" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Submit Button  -->
                <Button Grid.Row="2" Grid.Column="2" Width="70" Height="40" Background="LightGray" Content="{Binding Path= ButtonText}" Click="btnAddUpdate_Click" HorizontalAlignment="Center" Margin="10"/>
            </Grid>
        </ScrollViewer>
   
</Window>
