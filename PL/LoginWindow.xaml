<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoginWindow" Height="450" Width="800" Icon="sticker.ico" Background="Gainsboro"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" >

    <Window.Resources>
        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#FF6C757D" />
            <Setter Property="Background" Value="#FF343A40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="7" Name="PART_Border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- טריגר לעכבר נכנס -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#FF495057"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- שורה ראשונה: לוגו -->
        <Image Grid.Row="0" Source="Logo.png" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- שורה שנייה: תוכן -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <!--<TextBlock Text="Welcome to the system" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />-->
            <Label Content="ID:" FontSize="14" />
            <TextBox FontSize="14" Margin="0,0,0,10" Text="{Binding CurrentVolunteer.Id}" />
            <Label Content="Password:" FontSize="14" />
            <TextBox FontSize="14" Margin="0,0,0,10" Text="{Binding CurrentVolunteer.Password}" />
           
            <Button Content="Login" FontSize="16" Height="40" Width="100" 
                    Background="#0078D7" Foreground="White" BorderBrush="Transparent" 
                    HorizontalAlignment="Center" Click="LoginButton_Click" />
        </StackPanel>
    </Grid>
</Window>
