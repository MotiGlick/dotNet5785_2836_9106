<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800"  
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Grid Background="#f0f0f0">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- כותרת המסך -->
        <TextBlock Grid.Row="0" Text="Wellcome to the system" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- חלק ההזנה -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <!-- שדה תעודת זהות -->
            <Label Content="ID:" FontSize="14" />
            <TextBox  FontSize="14" Margin="0,0,0,10" Text="{Binding CurrentVolunteer.Id}" />

            <!-- שדה סיסמא (ניתן להסיר אם לא נדרש) -->
            <Label Content="Password:" FontSize="14" />
            <TextBox  FontSize="14" Margin="0,0,0,20" Text="{Binding CurrentVolunteer.Password}" />

            <!-- כפתור כניסה -->
            <Button Content="Login" FontSize="16" Height="40" Click="LoginButton_Click" />
        </StackPanel>

    </Grid>
</Window>
