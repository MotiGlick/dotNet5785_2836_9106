<Window  x:Class="PL.Call.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Call"
        mc:Ignorable="d" Icon="pack://application:,,,/sticker.ico"
        Title="CallWindow" Height="650" Width="800" WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}" Background="Gainsboro" Closed="Window_Closed" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Styles -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Gainsboro"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid ShowGridLines="False" Margin="10,20,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.7*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,20,15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,10,0,10">
                        <TextBlock Text="Call Details" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="DarkSlateGray" 
                                   HorizontalAlignment="Center" />
                        <Separator Background="DarkSlateGray" Height="2"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="1" Grid.Column="0" Content="Call Type:"  Margin="0,10,0,0" />
                        <DockPanel Grid.Row="1" Grid.Column="1" LastChildFill="True"  Margin="0,10,0,0">
                            <Border Background="Transparent" BorderBrush="DarkSlateGray" BorderThickness="1" Width="22" Height="22" CornerRadius="15" VerticalAlignment="Center" HorizontalAlignment="Center" DockPanel.Dock="Right" ToolTip="Select the type of the call.">
                                <TextBlock Text="?" FontSize="16"  VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            
                            <ComboBox IsEnabled="{Binding CurrentCall.status, Converter={StaticResource ConvertStatusOfCallToBoolKey}}" ItemsSource="{Binding Source={StaticResource CallTypeCollectionKey}}" 
                                      SelectedValue="{Binding CurrentCall.CallType, Mode=TwoWay}"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,5,0"/>
                        </DockPanel>

                        <Label Grid.Row="2" Grid.Column="0" Content="Call Address:"  Margin="0,10,0,0"/>
                        <DockPanel Grid.Row="2" Grid.Column="1" LastChildFill="True"  Margin="0,10,0,0">
                            <Border Background="Transparent" BorderBrush="DarkSlateGray" BorderThickness="1" Width="22" Height="22" CornerRadius="15" VerticalAlignment="Center" HorizontalAlignment="Center" DockPanel.Dock="Right" ToolTip="Enter the address of the call.">
                                <TextBlock Text="?" FontSize="16"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBox Text="{Binding CurrentCall.Address, Mode=TwoWay}"  IsEnabled="{Binding CurrentCall.status, Converter={StaticResource ConvertStatusOfCallToBoolKey}}"  HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                        </DockPanel>

                        <Label Grid.Row="3" Grid.Column="0" Content="Description:"  Margin="0,10,0,0"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" LastChildFill="True" HorizontalAlignment="Stretch"  Margin="0,10,0,0" ToolTip="Provide a brief explanation of the call.">
                            <Border Background="Transparent" BorderBrush="DarkSlateGray" BorderThickness="1" Width="22" Height="22" CornerRadius="15" VerticalAlignment="Center" HorizontalAlignment="Center" DockPanel.Dock="Right" ToolTip="Enter the address of the call.">
                                <TextBlock Text="?" FontSize="16"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBox Text="{Binding CurrentCall.Description, Mode=TwoWay}" IsEnabled="{Binding CurrentCall.status, Converter={StaticResource ConvertStatusOfCallToBoolKey}}"  HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                        </DockPanel>

                        <Label Grid.Row="4" Grid.Column="0" Content="Opening Time:"  Margin="0,10,0,0"/>
                        <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding CurrentCall.OpeningTime}"  Margin="0,10,0,0" IsEnabled="False"/>
                        <xctk:DateTimePicker Grid.Row="4" Grid.Column="4" 
                            Value="{Binding CurrentCall.OpeningTime}"
                            Margin="0,10,0,0" IsEnabled="False"
                            Format="Custom"  HorizontalContentAlignment="Center" TextAlignment="Left"
                             FormatString="dd/MM/yyyy HH:mm" />


                        <Label Grid.Row="5" Grid.Column="0" Content="Max Time to Handle:"  Margin="0,10,0,0"/>
                        <!--<DatePicker Grid.Row="5" Grid.Column="1"  SelectedDate="{Binding CurrentCall.MaxTime ,Mode=TwoWay}"  Margin="0,10,0,0" IsEnabled="{Binding CurrentCall.status, Converter={StaticResource ConvertStatusOfCallToBoolForMaxTimeKey}}" />-->
                        <xctk:DateTimePicker Grid.Row="5" Grid.Column="1" 
                          Value="{Binding CurrentCall.MaxTime, Mode=TwoWay}" 
                          Margin="0,10,0,0" 
                           HorizontalContentAlignment="Left" TextAlignment="Left"
                           IsEnabled="{Binding CurrentCall.status, Converter={StaticResource ConvertStatusOfCallToBoolForMaxTimeKey}}" 
                           Format="Custom" 
                          FormatString="dd/MM/yyyy HH:mm" />


                        <Label Grid.Row="6" Grid.Column="0" Content="Status:"  Margin="0,10,0,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentCall.status, Mode=TwoWay}" IsEnabled="False"  Margin="0,10,0,0"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Margin="10">
                    <TextBlock Text="Call Assignments" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="DarkSlateGray" 
                               Margin="0,0,0,10" 
                               HorizontalAlignment="Center" />
                    <Separator Background="DarkSlateGray" Height="2"/>
                    <Border BorderBrush="DarkSlateGray" BorderThickness="7" CornerRadius="5" Padding="5" Background="LightGray">
                        <ListView ItemsSource="{Binding CurrentCall.CallAssignsList}"   
                                  SelectedItem="{Binding SelectedCall}"  
                                  Height="Auto" 
                                  VerticalAlignment="Top"
                                  HorizontalContentAlignment="Center">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Volunteer Id" DisplayMemberBinding="{Binding VolunteerId}" Width="Auto" />
                                    <GridViewColumn Header="Volunteer name" DisplayMemberBinding="{Binding VolunteerName}" Width="Auto" />
                                    <GridViewColumn Header="Handle start time" DisplayMemberBinding="{Binding HndalStartTime}" Width="Auto" />
                                    <GridViewColumn Header="Handle end time" DisplayMemberBinding="{Binding HndalEndTime}" Width="Auto" />
                                    <GridViewColumn Header="Closure type" DisplayMemberBinding="{Binding ClosureType}" Width="Auto" />
                                </GridView>
                            </ListView.View> 
                        </ListView>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2" Grid.Column="0" Width="150" Height="45" Background="DarkSlateGray" Content="{Binding Path=ButtonText}" 
                        Click="btnAddUpdate_Click" HorizontalAlignment="Left" Margin="342,20,0,20" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
